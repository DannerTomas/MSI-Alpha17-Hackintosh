<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.alc274-headphones</string>
	<key>ProgramArguments</key>
	<array>
		<string>__RUNTIME__/alc274-headphones</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>StandardOutPath</key>
	<string>__LOGS__/stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__LOGS__/stderr.log</string>
</dict>
</plist>
